# Copie este arquivo para .env e preencha com os dados do painel do SuperDB:
# abra o projeto em https://app.superdb.com.br e clique em "Conectar".

# URL de auth. No SuperDB em nuvem é sempre esta.
NUXT_PUBLIC_SUPERDB_URL=https://auth.superdb.com.br

# Chave anon do projeto. É pública: vai no código do app, e quem protege os
# dados é o RLS do superdb/schema.sql. NUNCA ponha a service key aqui.
NUXT_PUBLIC_SUPERDB_ANON_KEY=

# Slug do projeto (aparece no endereço do projeto no painel).
NUXT_PUBLIC_SUPERDB_PROJECT=
