# Copie este arquivo para .env e preencha com os dados do painel do SuperDB:
# abra o projeto em https://app.superdb.com.br e clique em "Conectar".
# Depois de mudar o .env, reinicie o `npx expo start`.

# URL de auth. No SuperDB em nuvem é sempre esta.
EXPO_PUBLIC_SUPERDB_URL=https://auth.superdb.com.br

# Chave anon do projeto. É pública: vai dentro do app, e quem protege os dados
# é o RLS do superdb/schema.sql. NUNCA ponha a service key aqui.
EXPO_PUBLIC_SUPERDB_ANON_KEY=

# Slug do projeto (aparece no endereço do projeto no painel).
EXPO_PUBLIC_SUPERDB_PROJECT=
