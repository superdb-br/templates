# Copie este arquivo para .env.local e preencha com os dados do painel do
# SuperDB: abra o projeto em https://app.superdb.com.br e clique em "Conectar".

# URL de auth. No SuperDB em nuvem é sempre esta.
NEXT_PUBLIC_SUPERDB_URL=https://auth.superdb.com.br

# Chave anon do projeto. É pública (o prefixo NEXT_PUBLIC_ a deixa usável
# também no navegador); quem protege os dados é o RLS do schema.sql.
NEXT_PUBLIC_SUPERDB_ANON_KEY=

# Slug do projeto (aparece no endereço do projeto no painel).
NEXT_PUBLIC_SUPERDB_PROJECT=
